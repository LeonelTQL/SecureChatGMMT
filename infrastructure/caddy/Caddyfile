:80 {
    header {
        X-Content-Type-Options nosniff
        Cache-Control no-store
    }
    request_body {
        max_size 6MB
    }
    @internal path /internal/*
    respond @internal 404
    @auth path /api/auth/* /api/users /api/users/* /api/roles /api/roles/* /api/user-roles /api/user-roles/* /api/admin/* /docs* /health
    handle @auth {
        reverse_proxy https://auth-service:3001 {
            transport http {
                tls_trust_pool file /etc/caddy/ca.pem
            }
        }
    }
    handle /api/steganography/* {
        reverse_proxy https://stego:8000 {
            transport http {
                tls_trust_pool file /etc/caddy/ca.pem
            }
        }
    }
    respond 404
}
