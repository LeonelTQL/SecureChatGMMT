{
  "name": "ms-users-auth",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.0" }
  },
  "scripts": {
    "prebuild": "node scripts/clean.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
