{
  "openapi": "3.0.3",
  "info": {
    "title": "AUTH Backend V1",
    "version": "2.0.0",
    "description": "JWT RS256, sesiones revocables y autorización sobre asignaciones actuales. ADMIN administra identidad; USER consulta perfil; ANALYST analiza y consulta resultados propios."
  },
  "servers": [
    {
      "url": "https://localhost:3001"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "service": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Register": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{3,50}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{3,50}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "status": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": []
      },
      "UserPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{3,50}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "status": {
            "type": "boolean"
          }
        },
        "required": []
      },
      "RoleCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "ADMIN",
              "ANALYST",
              "USER"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          }
        },
        "required": [
          "name",
          "description"
        ]
      },
      "Role": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": []
      },
      "RolePatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "status": {
            "type": "boolean"
          }
        },
        "required": []
      },
      "AssignmentCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "role_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "user_id",
          "role_id"
        ]
      },
      "Assignment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "assignedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": []
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "enum": [
              900
            ]
          }
        },
        "required": []
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{3,50}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": []
      },
      "Identity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sub": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{3,50}$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "jti": {
            "type": "string",
            "format": "uuid"
          },
          "exp": {
            "type": "integer"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": []
      },
      "Check": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_token": {
            "type": "string",
            "maxLength": 4096
          },
          "action": {
            "type": "string",
            "enum": [
              "steganography.analyze",
              "steganography.results.read"
            ]
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "subject_token",
          "action"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "own",
              "all"
            ]
          }
        },
        "required": []
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Disponibilidad de AUTH y PostgreSQL",
        "security": [],
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Autenticación inválida o sesión revocada"
          },
          "403": {
            "description": "Rol vigente insuficiente"
          },
          "404": {
            "description": "Recurso inexistente"
          },
          "409": {
            "description": "Valor único o asignación duplicada"
          },
          "429": {
            "description": "Límite de intentos"
          },
          "500": {
            "description": "Error interno sin información sensible"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Registro público sin privilegios",
        "security": [],
