    {
      "name": "10 AUTH",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{auth_url}}/health"
      },
      "response": []
    },
    {
      "name": "12 Análisis esteganografía",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{analyst_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{image_path}}"
            }
          ]
        },
        "url": "{{stego_url}}/api/steganography/analyze"
      },
      "response": []
    },
    {
      "name": "11 Stego health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{stego_url}}/health"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "auth_url",
      "value": "https://localhost:3001"
    },
    {
      "key": "stego_url",
      "value": "https://localhost:8000"
    },
    {
      "key": "username",
      "value": "postman_user"
    },
    {
      "key": "email",
      "value": "postman@example.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "analyst_token",
      "value": ""
    },
    {
      "key": "image_path",
      "value": ".local/test-fixtures/lsb_full.png"
    }
  ]
}
