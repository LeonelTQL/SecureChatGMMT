{
  "info": {
    "name": "Backend V1 - autenticacion, RBAC y STEGO",
    "description": "STEGO activo en services/stego. Las primeras nueve solicitudes son la secuencia de registro/login, denegaci?n por roles y logout verificada; no concede roles. Las tres solicitudes de demostraci?n adicionales se ejecutan por separado: configurar analyst_token vigente de una cuenta de prueba autorizada e image_path local. Importar la CA y conservar TLS verificado. No guardar credenciales ni tokens al exportar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Registro",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"username\": \"{{username}}\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/api/auth/register",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('access_token', pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/api/auth/login",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 Perfil",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{auth_url}}/api/auth/profile",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "api",
            "auth",
            "profile"
          ]
        }
      },
      "response": []
    },
