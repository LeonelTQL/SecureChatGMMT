{
  "info": {
    "name": "Backend V1 — Leonel y Paul; Alejandro pendiente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Importar CA secrets/public/ca.pem. Registrar con contraseña local de 12–128 caracteres. Los endpoints de Alejandro fueron retirados; STEGO no analiza sin autorización."
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "https://localhost:3001"
    },
    {
      "key": "stego_url",
      "value": "https://localhost:8000"
    },
    {
      "key": "username",
      "value": "postman_user"
    },
    {
      "key": "email",
      "value": "postman@example.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Registro",
      "request": {
        "method": "POST",
        "url": "{{auth_url}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"username\": \"{{username}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login",
      "request": {
        "method": "POST",
        "url": "{{auth_url}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('access_token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Perfil",
      "request": {
        "method": "GET",
        "url": "{{auth_url}}/api/auth/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Verificar JWT",
      "request": {
        "method": "POST",
        "url": "{{auth_url}}/api/auth/verify",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Administración bloqueada hasta integrar Alejandro",
      "request": {
        "method": "GET",
        "url": "{{auth_url}}/api/users",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 503', () => pm.response.to.have.status(503));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 STEGO bloqueado sin decisión de autorización",
      "request": {
        "method": "POST",
        "url": "{{stego_url}}/api/steganography/analyze",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 503', () => pm.response.to.have.status(503));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Logout",
      "request": {
        "method": "POST",
        "url": "{{auth_url}}/api/auth/logout",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 JWT revocado",
      "request": {
        "method": "GET",
        "url": "{{auth_url}}/api/auth/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Sin autenticación",
      "request": {
        "method": "POST",
        "url": "{{stego_url}}/api/steganography/analyze",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
